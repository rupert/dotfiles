{
  "arch": "aarch64",
  "distro": "alpine",
  "alpine": {
    "version": "3.23.7",
    "kernelPackage": "linux-virt",
    "kernelImage": "vmlinuz-virt",
    "rootfsPackages": [
      "linux-virt",
      "rng-tools",
      "bash",
      "ca-certificates",
      "ca-certificates-bundle",
      "curl",
      "e2fsprogs",
      "e2fsprogs-extra",
      "nodejs",
      "npm",
      "uv",
      "python3",
      "openssh",
      "git",
      "github-cli"
    ],
    "initramfsPackages": [],
    "krunfwVersion": "v5.2.1"
  },
  "rootfs": {
    "label": "gondolin-root"
  },
  "postBuild": {
    "copy": [
      {
        "src": "./gitconfig",
        "dest": "/etc/gitconfig"
      }
    ]
  }
}
